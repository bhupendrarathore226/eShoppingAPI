{
  "IdentityServer": {
    "Authority": "https://identity.eshopping.com"
  },

  "SwaggerGateway": {
    "ExposeSwaggerUI": false
  },

  "SwaggerEndPoints": [
    {
      "Key": "catalog",
      "Config": [
        {
          "Name": "Catalog API",
          "Version": "v1",
          "Url": "http://catalog-api/swagger/v1/swagger.json"
        }
      ]
    },
    {
      "Key": "basket",
      "Config": [
        {
          "Name": "Basket API",
          "Version": "v1",
          "Url": "http://basket-api/swagger/v1/swagger.json"
        }
      ]
    },
    {
      "Key": "ordering",
      "Config": [
        {
          "Name": "Ordering API",
          "Version": "v1",
          "Url": "http://ordering-api/swagger/v1/swagger.json"
        }
      ]
    }
  ]
}
