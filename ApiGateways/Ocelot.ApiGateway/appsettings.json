{
  "AllowedHosts": "*",

  "IdentityServer": {
    "Authority": "https://localhost:51343"
  },

  "SwaggerGateway": {
    "RoutePrefix": "gateway/docs",
    "DocumentTitle": "EShopping API Gateway",
    "ExposeSwaggerUI": true
  },

  "SwaggerEndPoints": [],

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  }
}
