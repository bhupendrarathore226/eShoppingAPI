{
  "AllowedHosts": "*",

  "IdentityServer": {
    "Authority": "https://localhost:51343"
  },

  // ── Swagger aggregation endpoints ──────────────────────────────────────────
  // These URLs are the *direct* downstream swagger.json endpoints.
  // MMLib.SwaggerForOcelot fetches them and transforms the paths to gateway
  // upstream routes so the aggregated UI reflects actual gateway URLs.
  // Keep in sync with DownstreamHostAndPorts in ocelot.*.json.
  // PRODUCTION: Remove or guard this section; Swagger is disabled in prod.
  "SwaggerEndPoints": [
    {
      "Key": "catalog",
      "Config": [
        {
          "Name": "Catalog API",
          "Version": "v1",
          "Url": "http://localhost:51335/swagger/v1/swagger.json"
        }
      ]
    },
    {
      "Key": "basket",
      "Config": [
        {
          "Name": "Basket API",
          "Version": "v1",
          "Url": "http://localhost:51339/swagger/v1/swagger.json"
        }
      ]
    },
    {
      "Key": "ordering",
      "Config": [
        {
          "Name": "Ordering API",
          "Version": "v1",
          "Url": "http://localhost:51346/swagger/v1/swagger.json"
        }
      ]
    }
  ],

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  }
}
