<!--
  ORDERING API — API-level policy
  External path  : /order/v1/...
  Internal path  : /api/v1/Order/...

  Rules
  ─────
  • All operations require a valid JWT.
  • Writes (POST/PUT/DELETE) require role order.write OR admin.
  • GET orders/{userName}: the user may only query their own orders
    (enforced by comparing X-User-Id with the userName route param).
  • Retry on 502/503 (ordering-api may be spinning up after cold start).
  • 45-second timeout — EF migrations and consumer startup can be slow.
-->
<policies>
  <!-- ═══════════════════════════════ INBOUND ══════════════════════════════ -->
  <inbound>
    <base />

    <!-- 1. Route to ordering backend -->
    <set-backend-service base-url="{{ordering-backend-url}}" />

    <!-- 2. Rewrite: /order/v1/Order/... → /api/v1/Order/... -->
    <rewrite-uri template="@("/api/v1" + context.Request.Url.Path.Substring(
                               context.Request.Url.Path.IndexOf("/Order")))"
                 copy-unmatched-params="true" />

    <!-- 3. JWT — required for all ordering operations -->
    <validate-jwt header-name="Authorization"
                  failed-validation-httpcode="401"
                  failed-validation-error-message="Authentication required to access orders"
                  require-expiration-time="true"
                  require-scheme="Bearer"
                  require-signed-tokens="true"
                  clock-skew="0:0:30">
      <openid-config url="{{identity-server-url}}/.well-known/openid-configuration" />
      <audiences>
        <audience>EShoppingGateway</audience>
      </audiences>
      <issuers>
        <issuer>{{identity-server-url}}</issuer>
      </issuers>
    </validate-jwt>

    <!-- 4. Validate claims for write operations -->
    <set-variable name="jwt" value="@(context.Request.Headers
                                       .GetValueOrDefault("Authorization","")
                                       .Replace("Bearer ","").AsJwt())" />
    <choose>
      <when condition="@(context.Request.Method == "POST" ||
                         context.Request.Method == "PUT"  ||
                         context.Request.Method == "DELETE")">
        <choose>
          <when condition="@{
            var jwt = (Jwt)context.Variables["jwt"];
            var roles = jwt?.Claims.Where(c => c.Key == "role").Select(c => c.Value)
                         ?? Enumerable.Empty<string>();
            return !roles.Contains("admin") && !roles.Contains("order.write");
          }">
            <return-response>
              <set-status code="403" reason="Insufficient privileges" />
              <set-header name="Content-Type" exists-action="override">
                <value>application/problem+json</value>
              </set-header>
              <set-body>@{
                return new JObject(
                  new JProperty("type",   "https://eshopping.com/errors/forbidden"),
                  new JProperty("title",  "You do not have permission to modify orders"),
                  new JProperty("status", 403),
                  new JProperty("correlationId", (string)context.Variables["correlationId"])
                ).ToString();
              }</set-body>
            </return-response>
          </when>
        </choose>
      </when>
    </choose>

    <!-- 5. Rate limit: 30 requests / 60s per authenticated user -->
    <rate-limit-by-key calls="30" renewal-period="60"
                       counter-key="@(((Jwt)context.Variables["jwt"])?.Subject
                                       ?? context.Subscription.Id)"
                       remaining-calls-header-name="X-RateLimit-Remaining"
                       retry-after-header-name="Retry-After" />

    <!-- 6. Forward verified identity headers -->
    <set-header name="X-User-Id" exists-action="override">
      <value>@(((Jwt)context.Variables["jwt"])?.Subject ?? string.Empty)</value>
    </set-header>
    <set-header name="X-User-Roles" exists-action="override">
      <value>@(string.Join(",",
                  ((Jwt)context.Variables["jwt"])?.Claims
                    .Where(c => c.Key == "role")
                    .Select(c => c.Value)
                  ?? Enumerable.Empty<string>()))</value>
    </set-header>
    <set-header name="X-Forwarded-For" exists-action="override">
      <value>@(context.Request.IpAddress)</value>
    </set-header>
    <set-header name="Authorization" exists-action="delete" />
  </inbound>

  <!-- ═══════════════════════════════ BACKEND ══════════════════════════════ -->
  <backend>
    <!-- Ordering writes can be slow (EF + validation). Allow 45s total. -->
    <retry condition="@(context.Response.StatusCode == 502 ||
                        context.Response.StatusCode == 503)"
           count="2"
           interval="2"
           first-fast-retry="false">
      <forward-request timeout="45"
                       follow-redirects="false"
                       buffer-request-body="true"
                       fail-on-error-status-code="false" />
    </retry>
  </backend>

  <!-- ════════════════════════════════ OUTBOUND ════════════════════════════ -->
  <outbound>
    <base />
    <set-header name="X-Response-Time-ms" exists-action="override">
      <value>@(context.Elapsed.TotalMilliseconds.ToString("F0"))</value>
    </set-header>
  </outbound>

  <!-- ════════════════════════════════ ON-ERROR ════════════════════════════ -->
  <on-error>
    <base />
    <choose>
      <when condition="@(context.LastError.Reason == "Timeout")">
        <return-response>
          <set-status code="504" reason="Gateway Timeout" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/problem+json</value>
          </set-header>
          <set-body>@{
            return new JObject(
              new JProperty("type",          "https://eshopping.com/errors/timeout"),
              new JProperty("title",         "Ordering service did not respond in time"),
              new JProperty("status",        504),
              new JProperty("correlationId", (string)context.Variables["correlationId"])
            ).ToString();
          }</set-body>
        </return-response>
      </when>
    </choose>
  </on-error>
</policies>
