  External path  : /basket/v1/...
  Internal path  : /api/v1/Basket/...

  All Basket operations require a valid JWT (shopping cart is user-specific).
  Checkout is additionally rate-limited at 3 calls per 10 s per user
  (matching the original Ocelot config).
-->
<policies>
  <!-- ═══════════════════════════════ INBOUND ══════════════════════════════ -->
  <inbound>
    <base />

    <!-- 1. Route to basket-api backend -->
    <set-backend-service base-url="{{basket-backend-url}}" />

    <!-- 2. Rewrite path: strip APIM prefix, prepend /api/v1 -->
    <rewrite-uri template="@("/api/v1" + context.Request.Url.Path.Substring(
                               context.Request.Url.Path.IndexOf("/Basket")))"
                 copy-unmatched-params="true" />

    <!-- 3. All basket operations require a valid JWT -->
    <validate-jwt header-name="Authorization"
                  failed-validation-httpcode="401"
                  failed-validation-error-message="Authentication required"
                  require-expiration-time="true"
                  require-scheme="Bearer"
                  require-signed-tokens="true"
                  clock-skew="0:0:30">
      <openid-config url="{{identity-server-url}}/.well-known/openid-configuration" />
      <audiences>
        <audience>EShoppingGateway</audience>
      </audiences>
      <issuers>
        <issuer>{{identity-server-url}}</issuer>
      </issuers>
    </validate-jwt>

    <!-- 4. Extra rate limit on Checkout endpoint (3 / 10 s per authenticated user) -->
    <choose>
      <when condition="@(context.Request.Url.Path.EndsWith("/Checkout",
                           StringComparison.OrdinalIgnoreCase))">
        <rate-limit-by-key calls="3" renewal-period="10"
                           counter-key="@(context.Request.Headers
                                           .GetValueOrDefault("Authorization","")
                                           .Replace("Bearer ","").AsJwt()?.Subject
                                         ?? context.Subscription.Id)"
                           remaining-calls-header-name="X-RateLimit-Remaining"
                           retry-after-header-name="Retry-After" />
      </when>
    </choose>

    <!-- 5. General basket rate limit: 60 calls / min per subscription -->
    <rate-limit-by-key calls="60" renewal-period="60"
                       counter-key="@(context.Subscription.Id + "-basket")"
                       remaining-calls-header-name="X-RateLimit-Remaining"
                       retry-after-header-name="Retry-After" />

    <!-- 6. Extract and forward validated claims as trusted headers -->
    <set-variable name="jwt" value="@(context.Request.Headers
                                       .GetValueOrDefault("Authorization","")
                                       .Replace("Bearer ","").AsJwt())" />
    <set-header name="X-User-Id" exists-action="override">
      <value>@(((Jwt)context.Variables["jwt"])?.Subject ?? string.Empty)</value>
    </set-header>
    <set-header name="X-User-Email" exists-action="override">
      <value>@(((Jwt)context.Variables["jwt"])?.Claims
                  .GetValueOrDefault("email", string.Empty))</value>
    </set-header>
    <set-header name="X-Forwarded-For" exists-action="override">
      <value>@(context.Request.IpAddress)</value>
    </set-header>
    <set-header name="Authorization" exists-action="delete" />
  </inbound>

  <!-- ═══════════════════════════════ BACKEND ══════════════════════════════ -->
  <backend>
    <!-- Only retry on 502/503 (not on 400/404 — those are client errors) -->
    <retry condition="@(context.Response.StatusCode == 502 ||
                        context.Response.StatusCode == 503)"
           count="2"
           interval="1"
           first-fast-retry="true">
      <forward-request timeout="15"
                       follow-redirects="false"
                       buffer-request-body="true"
                       fail-on-error-status-code="false" />
    </retry>
  </backend>

  <!-- ════════════════════════════════ OUTBOUND ════════════════════════════ -->
  <outbound>
    <base />
    <set-header name="X-Response-Time-ms" exists-action="override">
      <value>@(context.Elapsed.TotalMilliseconds.ToString("F0"))</value>
    </set-header>
  </outbound>

  <!-- ════════════════════════════════ ON-ERROR ════════════════════════════ -->
  <on-error>
    <base />
    <!-- Return a structured failure for Checkout so clients can show UI feedback -->
    <choose>
      <when condition="@(context.Request.Url.Path.EndsWith("/Checkout",
                    StringComparison.OrdinalIgnoreCase) &&
                  (context.LastError.Source == "forward-request" ||
                   context.LastError.Reason == "Timeout"))">
        <return-response>
          <set-status code="503" reason="Checkout temporarily unavailable" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/problem+json</value>
          </set-header>
          <set-body>@{
            return new JObject(
              new JProperty("type",          "https://eshopping.com/errors/checkout-unavailable"),
              new JProperty("title",         "Checkout service is temporarily unavailable"),
              new JProperty("status",        503),
              new JProperty("correlationId", (string)context.Variables["correlationId"])
            ).ToString();
          }</set-body>
        </return-response>
      </when>
    </choose>
  </on-error>
</policies>
